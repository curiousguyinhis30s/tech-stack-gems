{
  "name": "tech-stack-gems",
  "version": "1.0.0",
  "description": "Battle-tested hackable tools library with L3 Deep Mod enhancements",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target node --minify && tsc --emitDeclarationOnly",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "keywords": [
    "hackable",
    "self-hosted",
    "open-source",
    "activepieces",
    "formbricks",
    "calcom",
    "growthbook",
    "novu",
    "uptime-kuma",
    "l3-deep-mod"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "@types/node": "^20.11.17",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
